<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- <xacro:include filename="$(find unitree_go2_description)/transmission.xacro"/> -->

    <!--
        生成单条腿的 xacro 宏。
        name: 关节和 link 前缀，例如 lf/rf/lh/rh。
        mirror: 左右镜像符号，左腿为 1，右腿为 -1，用于 y 坐标和惯量交叉项。
        mirror_dae: 选择正常或镜像的视觉 mesh，同时决定髋关节限位方向。
        front_hind/front_hind_dae: 前后腿符号和视觉姿态，用于把同一套几何复制到前后两端。
    -->
    <xacro:macro name="leg" params="name mirror mirror_dae front_hind front_hind_dae">

        <!-- 髋关节连接 trunk 和 hip link，origin 根据前/后、左/右四种组合放置。 -->
        <joint name="${name}_hip_joint" type="revolute">
            <!-- 右前腿：x 为前向正，y 为右侧负。 -->
            <xacro:if value="${(mirror_dae == False) and (front_hind_dae == True)}">
                <origin rpy="0 0 0" xyz="${leg_offset_x} ${-leg_offset_y} 0"/>
            </xacro:if>
            <!-- 左前腿：x 为前向正，y 为左侧正。 -->
            <xacro:if value="${(mirror_dae == True) and (front_hind_dae == True)}">
                <origin rpy="0 0 0" xyz="${leg_offset_x} ${leg_offset_y} 0"/>
            </xacro:if>
            <!-- 右后腿：x 为后向负，y 为右侧负。 -->
            <xacro:if value="${(mirror_dae == False) and (front_hind_dae == False)}">
                <origin rpy="0 0 0" xyz="${-leg_offset_x} ${-leg_offset_y} 0"/>
            </xacro:if>
            <!-- 左后腿：x 为后向负，y 为左侧正。 -->
            <xacro:if value="${(mirror_dae == True) and (front_hind_dae == False)}">
                <origin rpy="0 0 0" xyz="${-leg_offset_x} ${leg_offset_y} 0"/>
            </xacro:if>
            <parent link="trunk"/>
            <child link="${name}_hip_link"/>
            <!-- 髋关节绕 x 轴转动，控制腿向外/向内摆动。 -->
            <axis xyz="1 0 0"/>
            <dynamics damping="${damping}" friction="${friction}"/>
            <!-- 左右腿坐标镜像后，髋关节正负限位也要翻转，避免可动范围方向相反。 -->
            <xacro:if value="${(mirror_dae == True)}">
                <limit effort="${hip_torque_max}" velocity="${hip_velocity_max}" lower="${hip_position_min}" upper="${hip_position_max}"/>
            </xacro:if>
            <xacro:if value="${(mirror_dae == False)}">
                <limit effort="${hip_torque_max}" velocity="${hip_velocity_max}" lower="${-hip_position_max}" upper="${-hip_position_min}"/>
            </xacro:if>            
        </joint>


        <!-- hip link：视觉使用真实 mesh，碰撞使用圆柱体，惯量使用 const.xacro 中的实测/拟合参数。 -->
        <link name="${name}_hip_link">
            <visual>
                <!-- 同一个 hip mesh 通过 RPY 旋转复用到四条腿。 -->
                <xacro:if value="${(mirror_dae == True) and (front_hind_dae == True)}">
                    <origin rpy="0 0 0" xyz="0 0 0"/>
                </xacro:if>
                <xacro:if value="${(mirror_dae == False) and (front_hind_dae == True)}">
                    <origin rpy="${PI} 0 0" xyz="0 0 0"/>
                </xacro:if>
                <xacro:if value="${(mirror_dae == True) and (front_hind_dae == False)}">
                    <origin rpy="0 ${PI} 0" xyz="0 0 0"/>
                </xacro:if>
                <xacro:if value="${(mirror_dae == False) and (front_hind_dae == False)}">
                    <origin rpy="${PI} ${PI} 0" xyz="0 0 0"/>
                </xacro:if>
                <geometry>
                    <mesh filename="file://$(find unitree_go2_description)/meshes/hip.dae" scale="1 1 1"/>
                </geometry>
                <!-- <material name="orange"/> -->
            </visual>
            <collision>
                <!-- 圆柱碰撞体沿髋部轴向放置，比 mesh 碰撞更稳定。 -->
                <origin rpy="${PI/2.0} 0 0" xyz="0 ${hip_offset*mirror} 0"/>
                <geometry>
                    <cylinder length="${hip_length}" radius="${hip_radius}"/>
                </geometry>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${hip_com_x*front_hind} ${hip_com_y*mirror} ${hip_com_z}"/>
                <mass value="${hip_mass}"/>
                <inertia
                    ixx="${hip_ixx}" ixy="${hip_ixy*mirror*front_hind}" ixz="${hip_ixz*front_hind}"
                    iyy="${hip_iyy}" iyz="${hip_iyz*mirror}"
                    izz="${hip_izz}"/>       
            </inertial>
        </link>

        <!-- 上腿关节连接 hip link 和 upper_leg link，绕局部 y 轴完成前后摆动。 -->
        <joint name="${name}_upper_leg_joint" type="revolute">
            <origin rpy="0 0 0" xyz="0 ${thigh_offset*mirror} 0"/>
            <parent link="${name}_hip_link"/>
            <child link="${name}_upper_leg_link"/>
            <axis xyz="0 1 0"/>
            <dynamics damping="${damping}" friction="${friction}"/>
            <limit effort="${thigh_torque_max}" velocity="${thigh_velocity_max}" lower="${thigh_position_min}" upper="${thigh_position_max}"/>
        </joint>


        <!-- upper_leg link：左右两侧使用不同 thigh mesh，碰撞体简化成长方体。 -->
        <link name="${name}_upper_leg_link">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <xacro:if value="${mirror_dae == True}">
                        <mesh filename="file://$(find unitree_go2_description)/meshes/thigh.dae" scale="1 1 1"/>
                    </xacro:if>
                    <xacro:if value="${mirror_dae == False}">
                        <mesh filename="file://$(find unitree_go2_description)/meshes/thigh_mirror.dae" scale="1 1 1"/>
                    </xacro:if>
                </geometry>
                <!-- <material name="orange"/> -->
            </visual>
            <collision>
                <!-- box 的长边沿上腿方向，中心放在 thigh_length 的一半处。 -->
                <origin rpy="0 ${PI/2.0} 0" xyz="0 0 ${-thigh_length/2.0}"/>
                <geometry>
                    <box size="${thigh_length} ${thigh_width} ${thigh_height}"/>
                </geometry>      
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${thigh_com_x} ${thigh_com_y*mirror} ${thigh_com_z}"/>
                <mass value="${thigh_mass}"/>
                <inertia
                    ixx="${thigh_ixx}" ixy="${thigh_ixy*mirror}" ixz="${thigh_ixz}"
                    iyy="${thigh_iyy}" iyz="${thigh_iyz*mirror}"
                    izz="${thigh_izz}"/>       
            </inertial>
        </link>


        <!-- 小腿关节位于上腿末端，绕局部 y 轴弯曲。 -->
        <joint name="${name}_lower_leg_joint" type="revolute">
            <origin rpy="0 0 0" xyz="0 0 ${-thigh_length}"/>
            <parent link="${name}_upper_leg_link"/>
            <child link="${name}_lower_leg_link"/>
            <axis xyz="0 1 0"/>
            <dynamics damping="${damping}" friction="${friction}"/>
            <limit effort="${calf_torque_max}" velocity="${calf_velocity_max}" lower="${calf_position_min}" upper="${calf_position_max}"/>
        </joint>


        <!-- lower_leg link：视觉为 calf mesh，碰撞体为长方体，计算量小且不易卡住地面。 -->
        <link name="${name}_lower_leg_link">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find unitree_go2_description)/meshes/calf.dae" scale="1 1 1"/>
                </geometry>
                <!-- <material name="orange"/> -->
            </visual>
            <collision>
                <!-- 小腿碰撞盒中心位于 calf_length 的一半处。 -->
                <origin rpy="0 ${PI/2.0} 0" xyz="0 0 ${-calf_length/2.0}"/>
                <geometry>
                    <box size="${calf_length} ${calf_width} ${calf_height}"/>
                </geometry>      
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${calf_com_x} ${calf_com_y} ${calf_com_z}"/>
                <mass value="${calf_mass}"/>
                <inertia
                    ixx="${calf_ixx}" ixy="${calf_ixy}" ixz="${calf_ixz}"
                    iyy="${calf_iyy}" iyz="${calf_iyz}"
                    izz="${calf_izz}"/>       
            </inertial>
        </link>


        <!-- 足端固定在小腿末端，CHAMP 使用该 link 作为足端接触/运动学参考。 -->
        <joint name="${name}_foot_joint" type="fixed">
            <origin rpy="0 0 0" xyz="0 0 ${-(calf_length)}"/>
            <parent link="${name}_lower_leg_link"/>
            <child link="${name}_foot_link"/>
        </joint>

        <!-- 足端简化为球体，视觉球略小于碰撞球，避免渲染时看起来过大。 -->
        <link name="${name}_foot_link">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <sphere radius="${foot_radius-0.01}"/>
                </geometry>
                <!-- <material name="orange"/> -->
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <sphere radius="${foot_radius}"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="${foot_mass}"/>
                <!-- 实心球惯量公式：I = 2/5*m*r^2。 -->
                <inertia
                    ixx="${(2*foot_mass)/5.0*(foot_radius*foot_radius)}" ixy="0.0" ixz="0.0"
                    iyy="${(2*foot_mass)/5.0*(foot_radius*foot_radius)}" iyz="0.0"
                    izz="${(2*foot_mass)/5.0*(foot_radius*foot_radius)}"/>             
            </inertial>
        </link>

        <!--
            ros2_control 硬件接口声明。
            GazeboSimSystem 由 gz_ros2_control 插件实现，三个主动关节暴露 effort 命令接口，
            并反馈 position/velocity 给 joint_trajectory_controller。
        -->
        <ros2_control name="${name}" type="system">
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>
            <joint name="${name}_hip_joint">
                <command_interface name="effort"/>
                <state_interface name="position">
                    <param name="initial_value">${stand_hip_joint}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
        
            <joint name="${name}_upper_leg_joint">
                <command_interface name="effort"/>
                <state_interface name="position">
                    <param name="initial_value">${stand_upper_leg_joint}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
        
            <joint name="${name}_lower_leg_joint">
                <command_interface name="effort"/>
                <state_interface name="position">
                    <param name="initial_value">${stand_lower_leg_joint}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
        </ros2_control> 

        <!-- <xacro:leg_transmission name="${name}"/> -->

    </xacro:macro>
</robot>
