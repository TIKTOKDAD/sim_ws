<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!--
        Velodyne VLP-16 传感器模型。
        该文件定义安装支架、扫描 link 和 Gazebo gpu_lidar 传感器，输出话题为 velodyne_points。
    -->

    <!-- 雷达底座固定在 base_link 前上方。xyz 为相对 base_link 的安装位移。 -->
    <joint name="velodyne_base_mount_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0.2 0 0.08"/>
        <parent link="base_link"/>
        <child link="velodyne_base_link"/>
    </joint>

    <!-- VLP16 底座：使用两个视觉 mesh 还原外观，碰撞体用圆柱近似。 -->
    <link name="velodyne_base_link">
        <inertial>
            <mass value="0.83"/>
            <origin xyz="0 0 0.03585"/>
            <inertia ixx="0.000908059425" ixy="0" ixz="0" iyy="0.000908059425" iyz="0" izz="0.0011049624"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="file://$(find unitree_go2_description)/meshes/VLP16_base_1.dae"/>
            </geometry>
        </visual>
        <visual>
            <geometry>
                <mesh filename="file://$(find unitree_go2_description)/meshes/VLP16_base_2.dae"/>
            </geometry>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0.03585"/>
            <geometry>
                <cylinder length="0.0717" radius="0.0516"/>
            </geometry>
        </collision>
    </link>

    <!-- 扫描 link 位于底座上方，Gazebo lidar sensor 绑定到 velodyne。 -->
    <joint name="velodyne_base_scan_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0.0377"/>
        <parent link="velodyne_base_link"/>
        <child link="velodyne"/>
    </joint>

    <!-- 扫描头视觉 mesh 单独放置，惯量极小，主要用于提供 frame 和外观。 -->
    <link name="velodyne">
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
        </inertial>
        <visual>
            <origin xyz="0 0 -0.0377"/>
            <geometry>
                <mesh filename="file://$(find unitree_go2_description)/meshes/VLP16_scan.dae"/>
            </geometry>
        </visual>
    </link>

    <!-- Gazebo Sim 的 GPU 激光雷达。ros_gz_bridge 会把该话题转换成 PointCloud2。 -->
    <gazebo reference="velodyne">
        <sensor name="velodyne-VLP16" type="gpu_lidar">
            <topic>velodyne_points</topic>
            <update_rate>10</update_rate>
            <gz_frame_id>velodyne</gz_frame_id>
            <lidar>
                <scan>
                    <!-- 水平 360 度扫描，samples 控制每圈点数。 -->
                    <horizontal>
                        <samples>440</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                    <!-- 垂直 16 线，对应 VLP-16 的线束数量和约 30 度视场。 -->
                    <vertical>
                        <samples>16</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.261799</min_angle>
                        <max_angle>0.261799</max_angle>
                    </vertical>
                </scan>
                <!-- 有效测距范围和距离分辨率。 -->
                <range>
                    <min>0.5</min>
                    <max>131.0</max>
                    <resolution>0.001</resolution>
                </range>
                <!-- 点云距离噪声，模拟真实雷达测距误差。 -->
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.008</stddev>
                </noise>
                <frame_id>velodyne</frame_id>
            </lidar>
            <visualize>true</visualize>

            <!-- always_on 让传感器随仿真启动持续发布，不依赖订阅者激活。 -->
            <always_on>1</always_on>
        </sensor>
    </gazebo>
</robot>
