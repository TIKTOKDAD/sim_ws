<?xml version="1.0" ?>
<sdf version="1.8">
  <!--
    city_street 世界：面向 Unitree Go2 城市道路/街区感知与行走测试的室外 Gazebo 场景。
    场景不依赖外部模型库，使用 SDF 基础几何构建高楼、道路、路缘、绿化、车辆和城市设施。
  -->
  <world name="city_street">
    <!-- 1 ms 物理步长适合四足机器人足端接触，静态城市几何主要提供碰撞和感知参照。 -->
    <physics name="1ms" type="bullet-featherstone">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Gazebo Sim 系统插件：物理、传感器、用户命令、场景广播和接触检测。 -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.44 0.47 0.50 1</ambient>
      <background>0.68 0.76 0.86 1</background>
      <shadows>true</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>36 -46 24 0 0.48 2.36</pose>
      </camera>
    </gui>

    <!-- 下午方向光，拉出建筑和行道树阴影，便于检查相机和激光点云层次。 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.92 0.88 0.78 1</diffuse>
      <specular>0.25 0.22 0.18 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.55 0.35 -0.76</direction>
    </light>

    <!--
      城市底板：只用一个 z=0 的平面承担主要地面碰撞。
      道路、人行道铺装等薄层尽量作为视觉涂层，避免 Go2 足端被多层重叠 collision 卡住。
    -->
    <model name="city_ground">
      <static>true</static>
      <link name="link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>120 90</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <pose>0 0 -0.012 0 0 0</pose>
          <geometry>
            <box>
              <size>120 90 0.024</size>
            </box>
          </geometry>
          <material>
            <ambient>0.21 0.34 0.22 1</ambient>
            <diffuse>0.24 0.43 0.25 1</diffuse>
            <specular>0.03 0.04 0.03 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- 主干路和十字路口。沥青只作为视觉薄层，碰撞由 city_ground 的平面提供。 -->
    <model name="asphalt_main_road">
      <static>true</static>
      <link name="link">
        <visual name="asphalt">
          <geometry>
            <box>
              <size>100 14 0.006</size>
            </box>
          </geometry>
          <material>
            <ambient>0.055 0.058 0.060 1</ambient>
            <diffuse>0.075 0.078 0.080 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.002 0 0 0</pose>
    </model>

    <model name="asphalt_cross_road">
      <static>true</static>
      <link name="link">
        <visual name="asphalt">
          <geometry>
            <box>
              <size>14 74 0.006</size>
            </box>
          </geometry>
          <material>
            <ambient>0.052 0.055 0.058 1</ambient>
            <diffuse>0.070 0.073 0.076 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.001 0 0 0</pose>
    </model>

