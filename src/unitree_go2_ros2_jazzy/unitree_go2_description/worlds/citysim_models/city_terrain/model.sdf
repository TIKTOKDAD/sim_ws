<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <model name="city_terrain">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>500 500</size>
          </plane>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e+06</kp>
              <kd>100</kd>
              <max_vel>1</max_vel>
              <min_depth>0</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>50</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <heightmap>
            <use_terrain_paging>false</use_terrain_paging>
            <texture>
              <diffuse>../ocean/materials/textures/soil_sand_0045_01.jpg</diffuse>
              <size>10</size>
              <normal>materials/textures/flat_normal.png</normal>
            </texture>
            <blend>
              <min_height>0</min_height>
              <fade_dist>1.5</fade_dist>
            </blend>
            <texture>
              <diffuse>../ocean/materials/textures/soil_sand_0045_01.jpg</diffuse>
              <size>10</size>
              <normal>materials/textures/flat_normal.png</normal>
            </texture>
            <blend>
              <min_height>2.5</min_height>
              <fade_dist>5</fade_dist>
            </blend>
            <texture>
              <diffuse>materials/textures/forest.jpg</diffuse>
              <size>10</size>
              <normal>materials/textures/flat_normal.png</normal>
            </texture>
            <uri>materials/textures/city_terrain.jpg</uri>
            <size>500 500 75</size>
            <!-- Gazebo Sim renders this Classic heightmap too high. Keep the
                 visual terrain below roads / buildings so road surfaces stay visible. -->
            <pos>40 -20 -2.48</pos>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
