<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <model name="Gas Station">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/gas_station.dae</uri>
          </mesh>
        </geometry>
        <material>
          <shader type="normal_map_tangent_space">
            <normal_map>materials/textures/GasStation_Normal.png</normal_map>
          </shader>
          <ambient>0.65 0.62 0.56 1</ambient>
          <diffuse>0.78 0.74 0.66 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/GasStation_Diffuse.png</albedo_map>
              <normal_map>materials/textures/GasStation_Normal.png</normal_map>
              <roughness>0.72</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
