<?xml version="1.0"?>
<sdf version="1.10">
  <model name="nasa_banner">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>meshes/nasa_banner.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/nasa_logo_banner.png</albedo_map>
              <roughness>0.82</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
