<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <model name="stop_light_post">
    <static>true</static>
    <link name="link">
      <visual name="post_visual">
        <geometry>
          <mesh>
            <uri>meshes/stop_light_post.obj</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
    <include>
      <name>right_light</name>
      <pose>0 -0.05 4.0 0 0 0</pose>
