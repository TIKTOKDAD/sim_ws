<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  unitree_go2_sim 保存 Go2 仿真的启动入口和运行参数。
  机器人几何和传感器描述位于 unitree_go2_description，本包负责把 Gazebo Sim、
  ros_gz_bridge、ros2_control、CHAMP 控制器和 RViz 组合起来。
-->
<package format="3">
  <name>unitree_go2_sim</name>
  <version>0.0.0</version>
  <description>unitree go2 robot simulation</description>
  <maintainer email="khaledgabr77@gmail.com">khaled</maintainer>
  <license>TODO: License declaration</license>

  <!-- 构建工具依赖：本包是 ament_cmake 资源包。 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- build_depend 保留 launch_ros，便于构建阶段校验 launch 相关资源。 -->
  <build_depend>launch_ros</build_depend>

  <!-- 运行期依赖：启动 Gazebo Sim 并与 ROS 2 话题互通。 -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>

  <!-- 运行期依赖：启动文件、机器人状态发布和可选关节状态工具。 -->
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>

  <export>
    <!-- 声明构建类型，colcon/ament 通过它选择正确的构建后端。 -->
    <build_type>ament_cmake</build_type>
  </export>
</package>
